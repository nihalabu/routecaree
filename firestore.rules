rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Users collection - basic user profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // NRI Users collection
    match /nriUsers/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Owner can update their own document
        resource.data.userId == request.auth.uid ||
        // Caretakers can update connectedCaretakers array only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedCaretakers']))
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Caretakers collection
    match /caretakers/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Owner can update their own document
        resource.data.userId == request.auth.uid ||
        // NRIs can update connectedNRIs array only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedNRIs']))
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Service Requests collection
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.caretakerUserId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.caretakerUserId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Messages collection (for future messaging feature)
    match /messages/{messageId} {
      allow read: if isSignedIn() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
    }
  }
}
